# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# You might have to increase this further if you allocate large stack variables in the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# You might have to increase this further if you spawn your own Rust threads 
# that allocate large stack variables; or better yet - use 
# `std::thread::Builder::new().stack_size(XXX)` for spawning
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# --- M5Stack CoreS3 固有の設定 ---

# CoreS3 の 8MB PSRAM は Quad 接続。Octal は GPIO33-37 を占有してしまい、
# I2S と LCD/SD の配線と両立しない。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# これが無いと WiFi と lwIP がバッファを確保できず再起動を繰り返す。
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# mbedTLS のバッファを PSRAM に置いてはいけない。ESP32-S3 の AES/SHA
# アクセラレータは DMA 駆動で、DMA は PSRAM に届かないため暗号処理が壊れる。
# CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC は既定の n のままにする。

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 長いファイル名を有効にする。既定の 8.3 形式では `/.m5a` や `config.toml` が
# 不正な名前として EINVAL で弾かれ、設定ファイルを作れない。
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# 旧 I2C ドライバとの衝突検査を外す。
# BSP は新しい I2C ドライバを使い、実行時に触るのはこちらだけ。一方
# esp-idf-hal が I2cDriver の後始末関数を参照しているために旧ドライバが
# リンクされ、起動時の検査が両方あると見なして中止してしまう。
# 旧ドライバは呼ばれないため、この検査を外して問題ない。
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

# LVGL の描画バッファを小さくする。
# 既定の 100 行だと 320x100x2 = 64KB を2枚使い、内部 DRAM の最大連続ブロックが
# 31KB まで落ちて WebSocket の受信タスクを作れなくなる。部分更新なので
# 行数を減らしても見た目は変わらない。
CONFIG_BSP_LCD_DRAW_BUF_HEIGHT=40

# LVGL の描画バッファを1枚にする。
# 2枚だと内部 DRAM を余分に使い、SD カードへの書き込みが DMA バッファを
# 確保できずに落ちる。顔の描画は差分が小さく、1枚でも滑らかに出る。
CONFIG_BSP_LCD_DRAW_BUF_DOUBLE=n

# WiFi の受信・送信バッファ数を既定の半分に減らす。
# この端末は音声（μ-law 約85kbps）と検索の小さいHTTPリクエストしか
# 使わず、高いWiFiスループットは要らない。既定の数はOpenAIとの
# WebSocket接続が張られたまま検索用のTLS接続を新たに張るだけの
# 内部DRAMの連続空きを圧迫し、web検索のスレッドを作れなくしていた。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=8
